#!/bin/sh
# Sadece canlı (ISO'dan açılmış) oturumda: masaüstüne "Pro OS'u Kur" simgesi koyar.
[ -d /run/live/medium ] || [ -d /lib/live/mount/medium ] || exit 0
D="$(xdg-user-dir DESKTOP 2>/dev/null)"; [ -n "$D" ] || D="$HOME/Desktop"
mkdir -p "$D"
cp /usr/share/applications/proos-kur.desktop "$D/"
chmod +x "$D/proos-kur.desktop"
gio set "$D/proos-kur.desktop" metadata::trusted true 2>/dev/null
exit 0
